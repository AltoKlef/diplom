<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://itemGroupListView.title"
      focusComponent="itemGroupsDataGrid">
    <data>
        <collection id="itemGroupsDc"
                    class="com.alto.diplom.entity.items.ItemGroup">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="itemGroupsDl" readOnly="true"/>
        </collection>
        <collection id="itemsDc" class="com.alto.diplom.entity.items.Item">
            <fetchPlan extends="_base">
                <property name="itemGroup" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="itemsDl">
                <query>
                    <![CDATA[select e from Item e where e.itemGroup = :group]]>
                </query>
            </loader>
        </collection>
        <instance id="itemGroupDc"
                  class="com.alto.diplom.entity.items.ItemGroup">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="itemGroupDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout id="layoutWrapper" classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="itemGroupsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <startSlot>
                        <button id="createButton" action="itemGroupsDataGrid.createAction"/>
                        <button id="editButton" action="itemGroupsDataGrid.editAction"/>
                        <button id="removeButton" action="itemGroupsDataGrid.removeAction"/>
                    </startSlot>
                    <endSlot>
                        <simplePagination id="pagination" dataLoader="itemGroupsDl"/>
                    </endSlot>
                </hbox>
                <treeDataGrid id="itemGroupsDataGrid"
                              width="100%"
                              minHeight="20em"
                              dataContainer="itemGroupsDc"
                              hierarchyProperty="parent"
                              columnReorderingAllowed="true">
                    <actions>
                        <action id="createAction" type="list_create"/>
                        <action id="editAction" type="list_edit">
                            <properties>
                                <property name="openMode" value="DIALOG"/>
                            </properties>
                        </action>
                        <action id="removeAction" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="name"/>
                    </columns>
                </treeDataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectButton" action="selectAction"/>
                    <button id="discardButton" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%" expand="itemsDataGrid">
                <h3 text="Товары в группе" id="itemsHeader"/>
                <hbox id="itemsButtonsPanel" classNames="buttons-panel">
                    <button id="itemCreateBtn" action="itemsDataGrid.create"/>
                    <button id="itemEditBtn" action="itemsDataGrid.edit"/>
                    <button id="itemRemoveBtn" action="itemsDataGrid.remove"/>
                </hbox>
                <dataGrid id="itemsDataGrid"
                          width="100%"
                          dataContainer="itemsDc">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns>
                        <column property="name"/>
                        <column property="price"/>
                        <column property="canPayByMark"/>
                        <column property="canMarkIncrease"/>
                    </columns>
                </dataGrid>
            </vbox>
        </formLayout>
    </layout>
</view>
