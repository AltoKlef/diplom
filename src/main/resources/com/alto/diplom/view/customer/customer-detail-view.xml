<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://customerDetailView.title"
      focusComponent="form">
    <data>
        <instance id="customerDc"
                  class="com.alto.diplom.entity.core.Customer">
            <fetchPlan extends="_instance_name">
                <property name="phone"/>
                <property name="firstName"/>
                <property name="lastName"/>
                <property name="isVerified"/>
                <property name="isBlocked"/>
                <property name="birthday"/>
                <property name="company" fetchPlan="_instance_name">
                    <property name="id"/>
                </property>
                <property name="createdBy"/>
                <property name="createdDate"/>
                <property name="customerGroups" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="customerDl"/>
        </instance>

        <instance id="bonusAccountDc" class="com.alto.diplom.entity.loyalty.CustomerBonusAccount">
            <fetchPlan extends="_base">
                <property name="loyaltyLevel" fetchPlan="_instance_name"/>
                <property name="company" fetchPlan="_base"/>
            </fetchPlan>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="customerDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="phoneField" property="phone"
                       pattern="^\+?[78][-\s]?\d{3}[-\s]?\d{3}[-\s]?\d{2}[-\s]?\d{2}$" required="true"/>
            <textField id="first_nameField" property="firstName"/>
            <textField id="last_nameField" property="lastName"/>
            <checkbox id="is_verifiedField" property="isVerified"/>
            <checkbox id="is_blockedField" property="isBlocked"/>
            <datePicker id="birthdayField" property="birthday"/>
            <entityPicker property="company">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <span id="groupsListSpan" title="Группы лояльности" classNames="font-bold"/>
            <formLayout dataContainer="bonusAccountDc">
                <textField property="mark" label="Бонусный баланс" readOnly="false"/>
                <entityPicker property="loyaltyLevel" label="Уровень лояльности">
                    <actions>
                        <action id="lookup" type="entity_lookup"/>
                        <action id="clear" type="entity_clear"/>
                    </actions>
                </entityPicker>
            </formLayout>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
