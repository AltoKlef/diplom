<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="diplom">
        <createTable tableName="ITEM">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ITEM"/>
            </column>
            <column name="NAME" type="VARCHAR(255)"/>
            <column name="PRICE" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="EXTERNAL_ID" type="VARCHAR(255)"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="CAN_PAY_BY_MARK" type="BOOLEAN"/>
            <column name="CAN_MARK_INCREASE" type="BOOLEAN"/>
            <column name="ITEM_GROUP_ID" type="UUID"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="diplom">
        <createTable tableName="ITEM_GROUP">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ITEM_GROUP"/>
            </column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="COMPANY_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="3" author="diplom">
        <createTable tableName="TRANSACTION_">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TRANSACTION_"/>
            </column>
            <column name="CUSTOMER_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="EXTERNAL_NUMBER" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="COMPANY_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="TOTAL_AMOUNT" type="DECIMAL(19, 2)"/>
            <column name="MARKS_EARNED" type="DECIMAL(19, 2)"/>
            <column name="MARKS_SPENT" type="DECIMAL(19, 2)"/>
            <column name="EXTERNAL_TRANSACTION_TIMESTAMP" type="${offsetDateTime.type}"/>
            <column name="INITIAL_TRANSACTION_ID" type="UUID"/>
            <column name="IS_NEED_TO_ACTIVATE" type="BOOLEAN"/>
            <column name="TIME_ACTIVATE" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="diplom">
        <createTable tableName="TRANSACTION_ITEM">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TRANSACTION_ITEM"/>
            </column>
            <column name="TRANSACTIONN_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ITEM_ID" type="UUID"/>
            <column name="QUANTITY" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="PRICE" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="TOTAL_SUM" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="MARKS_EARNED" type="DECIMAL(19, 2)"/>
            <column name="MARKS_SPENT" type="DECIMAL(19, 2)"/>
            <column name="DISCOUNT" type="DECIMAL(19, 2)"/>
        </createTable>
    </changeSet>
    <changeSet id="5" author="diplom">
        <createIndex indexName="IDX_ITEM_GROUP_COMPANY" tableName="ITEM_GROUP">
            <column name="COMPANY_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="COMPANY_ID" baseTableName="ITEM_GROUP"
                                 constraintName="FK_ITEM_GROUP_ON_COMPANY" referencedColumnNames="ID"
                                 referencedTableName="COMPANY"/>
    </changeSet>
    <changeSet id="6" author="diplom">
        <createIndex indexName="IDX_ITEM_ITEM_GROUP" tableName="ITEM">
            <column name="ITEM_GROUP_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="ITEM_GROUP_ID" baseTableName="ITEM"
                                 constraintName="FK_ITEM_ON_ITEM_GROUP" referencedColumnNames="ID"
                                 referencedTableName="ITEM_GROUP"/>
    </changeSet>
    <changeSet id="7" author="diplom">
        <createIndex indexName="IDX_TRANSACTION_ITEM_ITEM" tableName="TRANSACTION_ITEM">
            <column name="ITEM_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="ITEM_ID" baseTableName="TRANSACTION_ITEM"
                                 constraintName="FK_TRANSACTION_ITEM_ON_ITEM" referencedColumnNames="ID"
                                 referencedTableName="ITEM"/>
    </changeSet>
    <changeSet id="8" author="diplom">
        <createIndex indexName="IDX_TRANSACTION_ITEM_TRANSACTIONN" tableName="TRANSACTION_ITEM">
            <column name="TRANSACTIONN_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="TRANSACTIONN_ID" baseTableName="TRANSACTION_ITEM"
                                 constraintName="FK_TRANSACTION_ITEM_ON_TRANSACTIONN" onDelete="CASCADE"
                                 referencedColumnNames="ID" referencedTableName="TRANSACTION_"/>
    </changeSet>
    <changeSet id="9" author="diplom">
        <createIndex indexName="IDX_TRANSACTION__COMPANY" tableName="TRANSACTION_">
            <column name="COMPANY_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="COMPANY_ID" baseTableName="TRANSACTION_"
                                 constraintName="FK_TRANSACTION__ON_COMPANY" referencedColumnNames="ID"
                                 referencedTableName="COMPANY"/>
    </changeSet>
    <changeSet id="10" author="diplom">
        <createIndex indexName="IDX_TRANSACTION__CUSTOMER" tableName="TRANSACTION_">
            <column name="CUSTOMER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CUSTOMER_ID" baseTableName="TRANSACTION_"
                                 constraintName="FK_TRANSACTION__ON_CUSTOMER" referencedColumnNames="ID"
                                 referencedTableName="CUSTOMER"/>
    </changeSet>
    <changeSet id="11" author="diplom">
        <createIndex indexName="IDX_TRANSACTION__INITIAL_TRANSACTION" tableName="TRANSACTION_">
            <column name="INITIAL_TRANSACTION_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="INITIAL_TRANSACTION_ID" baseTableName="TRANSACTION_"
                                 constraintName="FK_TRANSACTION__ON_INITIAL_TRANSACTION" referencedColumnNames="ID"
                                 referencedTableName="TRANSACTION_"/>
    </changeSet>
</databaseChangeLog>