<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://transactionConfigDetailView.title"
      focusComponent="form">
    <data>
        <instance id="transactionConfigDc"
                  class="com.alto.diplom.entity.TransactionConfig">
            <fetchPlan extends="_base">
                <property name="company" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="transactionConfigDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="transactionConfigDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="daysToMarkActivationField" property="daysToMarkActivation"/>
            <textField id="minSumToIncreaseField" property="minSumToIncrease"/>
            <select id="markIncreaseModeField" property="markIncreaseMode"/>
            <entityPicker id="companyField" property="company">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
