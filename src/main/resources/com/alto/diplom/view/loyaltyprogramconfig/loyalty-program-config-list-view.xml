<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://loyaltyProgramConfigListView.title"
      focusComponent="loyaltyProgramConfigsDataGrid">
    <data>
        <collection id="loyaltyProgramConfigsDc" class="com.alto.diplom.entity.config.LoyaltyProgramConfig">
            <fetchPlan extends="_base">
                <property name="levels" fetchPlan="_base"/>
                <property name="company" fetchPlan="_instance_name"/>
                <property name="transactionConfig" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="loyaltyProgramConfigsDl"/>
        </collection>
        <instance id="loyaltyProgramConfigDc"
                  class="com.alto.diplom.entity.config.LoyaltyProgramConfig">
            <fetchPlan extends="_base">
                <property name="levels" fetchPlan="_base">
                    <property name="cashbackRate"/>
                    <property name="markspendRate"/>
                    <property name="requiredSum"/>
                </property>
            </fetchPlan>
            <collection id="levelsDc" property="levels"/>
        </instance>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout padding="false">
        <split width="100%" height="100%" orientation="HORIZONTAL" splitterPosition="40">
            <vbox id="lookupBox" height="100%" padding="true" spacing="true" expand="loyaltyProgramConfigsDataGrid">
                <genericFilter id="genericFilter" dataLoader="loyaltyProgramConfigsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox classNames="buttons-panel">
                    <button action="loyaltyProgramConfigsDataGrid.create"/>
                    <button action="loyaltyProgramConfigsDataGrid.edit"/>
                    <button action="loyaltyProgramConfigsDataGrid.remove"/>
                </hbox>
                <dataGrid id="loyaltyProgramConfigsDataGrid"
                          width="100%"
                          dataContainer="loyaltyProgramConfigsDc">
                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns>
                        <column property="name"/>
                        <column property="isActive"/>
                        <column property="transactionConfig"/>
                    </columns>
                </dataGrid>
            </vbox>
            <vbox id="detailsBox" height="100%" padding="true" spacing="true" expand="levelsDataGrid">
                <h3 text="Уровни лояльности" classNames="font-bold text-xl"/>
                <hbox classNames="buttons-panel">
                    <button action="levelsDataGrid.create"/>
                    <button action="levelsDataGrid.edit"/>
                    <button action="levelsDataGrid.remove"/>
                </hbox>
                <dataGrid id="levelsDataGrid"
                          width="100%"
                          dataContainer="levelsDc">
                    <actions>
                        <action id="create" type="list_create">
                            <properties>
                                <property name="openMode" value="DIALOG"/>
                            </properties>
                        </action>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>
                    <columns>
                        <column property="number"/>
                        <column property="name"/>
                        <column property="discount"/>
                        <column property="cashbackRate"/>
                        <column property="markspendRate"/>
                        <column property="requiredSum"/>
                    </columns>
                </dataGrid>
            </vbox>
        </split>
    </layout>
</view>
