<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://customerGroupListView.title"
      focusComponent="customerGroupsDataGrid">
    <data>
        <collection id="customerGroupsDc"
                    class="com.alto.diplom.entity.core.CustomerGroup">
            <fetchPlan extends="_base">
                <property name="loyaltyConfig" fetchPlan="_base"/>
                <property name="company" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="customerGroupsDl" readOnly="true"/>
        </collection>
        <instance id="customerGroupDc"
                  class="com.alto.diplom.entity.core.CustomerGroup">
            <fetchPlan extends="_base">
                <property name="loyaltyConfig" fetchPlan="_base"/>
                <property name="company" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="customerGroupDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout id="layoutWrapper" classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="customerGroupsDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <startSlot>
                        <button id="createButton" action="customerGroupsDataGrid.createAction"/>
                        <button id="editButton" action="customerGroupsDataGrid.editAction"/>
                        <button id="removeButton" action="customerGroupsDataGrid.removeAction"/>
                    </startSlot>
                    <endSlot>
                        <simplePagination id="pagination" dataLoader="customerGroupsDl"/>
                    </endSlot>
                </hbox>
                <dataGrid id="customerGroupsDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="customerGroupsDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="createAction" type="list_create"/>
                        <action id="editAction" type="list_edit"/>
                        <action id="removeAction" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="name"/>
                        <column property="loyaltyConfig"/>
                        <column property="company"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectButton" action="selectAction"/>
                    <button id="discardButton" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="customerGroupDc">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                        <responsiveStep minWidth="40em" columns="2"/>
                    </responsiveSteps>
                    <textField id="nameField" property="name"/>
                    <entityPicker id="loyaltyConfigField" property="loyaltyConfig">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <entityPicker id="companyField" property="company">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveButton" text="msg:///actions.Save" icon="CHECK" themeNames="primary"/>
                    <button id="cancelButton" text="msg:///actions.Cancel" icon="BAN"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>
