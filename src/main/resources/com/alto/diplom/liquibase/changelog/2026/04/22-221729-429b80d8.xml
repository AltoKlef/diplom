<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="0-create-link-table" author="diplom">
        <createTable tableName="CUSTOMER_CUSTOMER_GROUP_LINK">
            <column name="CUSTOMER_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CUSTOMER_GROUP_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="CUSTOMER_CUSTOMER_GROUP_LINK"
                       columnNames="CUSTOMER_ID, CUSTOMER_GROUP_ID"
                       constraintName="PK_CUST_GROUP_LINK"/>
    </changeSet>
    <changeSet id="3" author="diplom">
        <createTable tableName="ON_REGISTER_CONFIG">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ON_REGISTER_CONFIG"/>
            </column>
            <column name="COMPANY_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="IS_ACTIVE" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="MARK_INCREASE" type="DECIMAL(19, 2)"/>
            <column name="DAYS_TO_DELAYED_ACTIVATION" type="INT"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="diplom">
        <createIndex indexName="IDX_ON_REGISTER_CONFIG_COMPANY" tableName="ON_REGISTER_CONFIG">
            <column name="COMPANY_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="COMPANY_ID" baseTableName="ON_REGISTER_CONFIG"
                                 constraintName="FK_ON_REGISTER_CONFIG_ON_COMPANY" referencedColumnNames="ID"
                                 referencedTableName="COMPANY"/>
    </changeSet>
    <changeSet id="5" author="diplom">
        <dropIndex indexName="idx_customer_company" tableName="customer"/>
    </changeSet>
    <changeSet id="6" author="diplom">
        <dropIndex indexName="idx_loyalty_config_company" tableName="loyalty_program_config"/>
    </changeSet>
    <changeSet id="7" author="diplom">
        <addForeignKeyConstraint baseColumnNames="CUSTOMER_ID" baseTableName="CUSTOMER_CUSTOMER_GROUP_LINK"
                                 constraintName="FK_CUSCUSGRO_ON_CUSTOMER" referencedColumnNames="ID"
                                 referencedTableName="CUSTOMER"/>
    </changeSet>
    <changeSet id="8" author="diplom">
        <addForeignKeyConstraint baseColumnNames="CUSTOMER_GROUP_ID" baseTableName="CUSTOMER_CUSTOMER_GROUP_LINK"
                                 constraintName="FK_CUSCUSGRO_ON_CUSTOMER_GROUP" referencedColumnNames="ID"
                                 referencedTableName="CUSTOMER_GROUP"/>
    </changeSet>
</databaseChangeLog>