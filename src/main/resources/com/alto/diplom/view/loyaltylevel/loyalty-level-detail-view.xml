<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://loyaltyLevelDetailView.title"
      focusComponent="form">
    <data>
        <instance id="loyaltyLevelDc"
                  class="com.alto.diplom.entity.loyalty.LoyaltyLevel">
            <fetchPlan extends="_base">
                <property name="loyaltyProgramConfig" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="loyaltyLevelDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="loyaltyLevelDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="discountField" property="discount"/>
            <textField id="cashback_rateField" property="cashbackRate"/>
            <textField id="markspend_rateField" property="markspendRate"/>
            <textField id="numberField" property="number"/>
            <textField id="required_sumField" property="requiredSum"/>
            <entityPicker id="loyaltyProgramConfigField" property="loyaltyProgramConfig">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
